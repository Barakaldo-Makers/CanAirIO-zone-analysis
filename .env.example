# ─────────────────────────────────────────────────────────────────────
#  CanAirIO-zone-analysis — configuration
#  Copy to .env and fill in. NEVER commit .env (see .gitignore).
#
#  cp .env.example .env
# ─────────────────────────────────────────────────────────────────────

# ── InfluxDB 1.x ─────────────────────────────────────────────────────
INFLUXDB_DB=canairio
INFLUXDB_ADMIN_USER=admin
INFLUXDB_ADMIN_PASSWORD=CHANGE_ME
INFLUXDB_USER=sensor
INFLUXDB_USER_PASSWORD=CHANGE_ME

# ── Grafana (optional dashboard) ─────────────────────────────────────
GRAFANA_ADMIN_PASSWORD=CHANGE_ME

# ── Analysis cycle ───────────────────────────────────────────────────
# Seconds between full analysis cycles.
ANALYSIS_INTERVAL=1800

# ── Output ───────────────────────────────────────────────────────────
# Absolute path to the git clone (or plain folder) where the JSON files
# are written. The container writes here as AI_BRIDGE_UID:AI_BRIDGE_GID.
SITE_DIR=./site
# Your own UID/GID, so the published files are not owned by root:
#   id -u ; id -g
AI_BRIDGE_UID=1000
AI_BRIDGE_GID=1000
# Public URL of your site, linked from the Telegram messages. Leave empty
# if you have none.
WEB_URL=

# ── OpenAQ: official reference stations worldwide ────────────────────
# Free key: https://explore.openaq.org/register
# Without it the project still works, but zones outside a local network
# fall back to the CAMS model instead of real stations.
OPENAQ_API_KEY=

# ── Outlier filtering: sliding window + historical repository ────────
# Adapted from Allka (UPC, 2025), ch. 6. A point the window's MAD would
# reject is kept if it fits the historical distribution for its hour of
# day, or if it belongs to a sustained excursion. Without this, a real
# pollution episode is deleted before the episode detector can see it.
# Set ESOD_ENABLE=0 for the old window-only behaviour.
ESOD_ENABLE=1
ESOD_RUN_H=2           # consecutive hours that make it a real excursion
ESOD_STUCK_H=6         # hours pinned to the same figure = faulty sensor
ESOD_HIST_DAYS=90      # history window
ESOD_HIST_MIN_N=14     # samples per hour-of-day before trusting history
ESOD_HIST_K=1.5        # margin over the historical p95
ESOD_HIST_WRITE_H=48   # hours rewritten each cycle

# ── Telegram alerts (optional) ───────────────────────────────────────
# Leave both empty to disable. Create a bot with @BotFather.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Legacy / unused ──────────────────────────────────────────────────
# Kept only so an older docker-compose does not fail to interpolate.
OLLAMA_MODEL=
