# ─────────────────────────────────────────────────────────────────────
#  CanAirIO-zone-analysis — configuration
#  Copy to .env and fill in. NEVER commit .env (see .gitignore).
#
#  cp .env.example .env
# ─────────────────────────────────────────────────────────────────────

# ── InfluxDB 1.x ─────────────────────────────────────────────────────
INFLUXDB_DB=canairio
INFLUXDB_ADMIN_USER=admin
INFLUXDB_ADMIN_PASSWORD=CHANGE_ME
INFLUXDB_USER=sensor
INFLUXDB_USER_PASSWORD=CHANGE_ME

# ── Grafana (optional dashboard) ─────────────────────────────────────
GRAFANA_ADMIN_PASSWORD=CHANGE_ME

# ── Analysis cycle ───────────────────────────────────────────────────
# Seconds between full analysis cycles.
ANALYSIS_INTERVAL=1800

# ── Output ───────────────────────────────────────────────────────────
# Absolute path to the git clone (or plain folder) where the JSON files
# are written. The container writes here as AI_BRIDGE_UID:AI_BRIDGE_GID.
SITE_DIR=./site
# Your own UID/GID, so the published files are not owned by root:
#   id -u ; id -g
AI_BRIDGE_UID=1000
AI_BRIDGE_GID=1000
# Public URL of your site, linked from the Telegram messages. Leave empty
# if you have none.
WEB_URL=

# ── OpenAQ: official reference stations worldwide ────────────────────
# Free key: https://explore.openaq.org/register
# Without it the project still works, but zones outside a local network
# fall back to the CAMS model instead of real stations.
OPENAQ_API_KEY=

# ── Outlier filtering: sliding window + historical repository ────────
# Adapted from Allka (UPC, 2025), ch. 6. A point the window's MAD would
# reject is kept if it fits the historical distribution for its hour of
# day, or if it belongs to a sustained excursion. Without this, a real
# pollution episode is deleted before the episode detector can see it.
# Set ESOD_ENABLE=0 for the old window-only behaviour.
ESOD_ENABLE=1
ESOD_RUN_H=2           # consecutive hours that make it a real excursion
ESOD_STUCK_H=6         # hours pinned to the same figure = faulty sensor
ESOD_HIST_DAYS=90      # history window
ESOD_HIST_MIN_N=14     # samples per hour-of-day before trusting history
ESOD_HIST_K=1.5        # margin over the historical p95
ESOD_HIST_WRITE_H=48   # hours rewritten each cycle

# ── Correction-factor drift (alpha-of-W rule) ────────────────────────
# From Allka (UPC, 2025), ch. 4. Drift is declared when at least
# DRIFT_ALPHA of the last DRIFT_W days fall outside the band of the
# preceding history. Aggregated per day, not per cycle: sensor ageing
# happens over weeks.
DRIFT_ENABLE=1
DRIFT_W=6
DRIFT_ALPHA=4
DRIFT_MIN_DAYS=12
DRIFT_K=3.0
DRIFT_BAND_MIN_PCT=10
DRIFT_HIST_DAYS=120
# Cobertura minima (horas emparejadas) para que un dia cuente en la deriva.
# A 0 no filtra, y asi debe quedarse hasta que /drift diga
# 'filtrar_ayudaria': el propio detector contrasta si el ruido del factor se
# concentra en los dias de poca cobertura, y filtrar sin esa evidencia solo
# tira datos. El contraste necesita DRIFT_COB_MIN_DIAS dias para tener
# potencia (medido: 62 % de acierto a 28 dias, 82 % a 40, 92 % a 60).
DRIFT_MIN_PAIRS=0
DRIFT_COB_MIN_DIAS=40

# ── Euskadi: hour stamping of the hourly CSVs ────────────────────────
# Each CSV value labelled "H" (GMT) is stamped at H + this offset. The
# labels run 01:00-24:00, so "H" is the END of the hour and -1 stamps its
# start. Don't change it without a /lag-scan verdict backed by two metrics.
EUSKADI_HOUR_OFFSET=-1

# ── EEA: official European reference (backup of the local network) ───
# Third link in the chain: euskadi -> OpenAQ -> EEA -> CAMS. Downloads
# hourly UTD data straight from the European Environment Agency, so it
# backs up Open Data Euskadi automatically and covers any European zone.
# Needs a parquet reader: fastparquet <2026.5 (see requirements.txt; newer
# releases are built for SSE4.2 CPUs only). No API key required.
EEA_ENABLED=1
EEA_RADIUS_KM=25
EEA_MAX_STATIONS=12
# Station metadata (coordinates). The AQViewer serves a ZIP with a CSV
# inside and returns 403 to requests without a User-Agent. URL verified
# against the EEAaq R package (CRAN). If it ever moves, check the viewer
# at discomap.eea.europa.eu/App/AQViewer and set the new URL here, or
# pin sampling points by hand with EEA_FORCE_SPOS below.
# Probe it from the server with: bash sonda-eea.sh
EEA_METADATA_URL=
EEA_CACHE_DIR=/tmp/eea-cache
EEA_METADATA_TTL=604800
# Escape hatch: explicit sampling points, "ES:SP_1234,ES:SP_5678".
# With this set, eea.py needs no metadata and no coordinates.
EEA_FORCE_SPOS=
# Time zone of the EEA Start/End columns. The EEA does not document it
# (no offset in the values), but the metadata declares one per station
# ('Timezone', e.g. UTC+01). 'metadato' applies it when the parquet time
# is naive; 'utc' reads it as UTC. A single global offset would be wrong
# in Europe (PT UTC+0, ES UTC+1, GR UTC+2).
EEA_TZ_MODE=metadato
# Manual correction in hours. -1 is MEASURED for the Basque network: the
# EEA publishes exactly the same values as Open Data Euskadi one hour
# later (23 identical comparisons, see docs/VALIDACION.md case 10). The
# Basque CSV labels hours 01:00-24:00, i.e. the END of each hour, which
# the EEA takes as Start. For a NEW European zone, check it again: with a
# local network, /eea-debug's cotejo gives the relative offset; without
# one, /lag-scan (ideally ?mac= with a sensor next to a cabin).
EEA_HOUR_OFFSET=-1
# Safety caps for the data download. The module fetches the URL list and
# then ONLY the files of the chosen stations (one parquet per sampling
# point, ~100 kB each); these caps stop it cold if that ever balloons.
EEA_MAX_FILES=40
EEA_MAX_MB=60

# ── PM correction factor: estimator ──────────────────────────────────
# Since 1.4.0 the factor is the MEDIAN of the hourly reference/sensor
# ratios, with a distribution-free 95% CI, instead of the ratio of the
# two window means (which flipped sign in four days and made the drift
# band 42x wider than the factor itself; see docs/VALIDACION.md case 9).
PM_FACTOR_MIN_RATIOS=12   # minimum valid hourly ratios for the median
PM_FACTOR_CI_MAX=1.5      # CI95 upper/lower above this = 'incierto'

# ── Acoustics: verdict indecision band ───────────────────────────────
# Within this many dB of an RD 1367/2007 target or a WHO 2018
# recommendation the verdict is 'en_el_limite': a real node crossed the
# WHO threshold with a 1.1 dB change in four days, and a class-2 sound
# level meter is already allowed +-1.5 dB. These nodes are not class 2.
ACU_LIMITE_DB=2.0

# ── Reference-station history (prerequisite for TPB-D) ───────────────
# Keeps the hourly official series that would otherwise be discarded.
# TPB-D needs M >= 24 complete days because beta = 24/M must be <= 1.
REF_HIST_ENABLE=1
REF_HIST_DAYS=180

# ── Alerts ───────────────────────────────────────────────────────────
# Consecutive hours over threshold before an alert fires. MUST be > 1:
# with 1 the persistence check is skipped entirely and a single-hour
# spike raises an alert.
ALERT_PERSIST_H=2
ALERT_HYSTERESIS=0.10

# ── Telegram alerts (optional) ───────────────────────────────────────
# Leave both empty to disable. Create a bot with @BotFather.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Legacy / unused ──────────────────────────────────────────────────
# Kept only so an older docker-compose does not fail to interpolate.
OLLAMA_MODEL=