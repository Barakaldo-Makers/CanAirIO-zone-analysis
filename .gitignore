# ─── Secretos ────────────────────────────────────────────────────────
# Nunca subir credenciales. .env.example SÍ va al repo; .env NO.
.env
.env.*
!.env.example
*.env
!*.env.example
.gitconfig
**/credentials*
**/secrets*
*.pem
*.key
*_token*
!*_token*.example

# ─── Datos generados ─────────────────────────────────────────────────
site/
data/*.json
!data/*.example.json
*.rdb
influxdb_data/
grafana_data/

# ─── Copias de seguridad de despliegues ──────────────────────────────
backup-*/
*.bak
*.bak-*

# ─── Python ──────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ─── Sistema y editores ──────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/
*.code-workspace
*.swp
*~

# ─── Scripts de despliegue local ─────────────────────────────────────
# Los parches que se aplican sobre un despliegue propio no son parte del
# proyecto: llevan un payload embebido, pesan decenas de KB y quedan en el
# historial de todos los que clonen. Se ejecutan desde el repo, así que sin
# esta regla acaban dentro sin querer.
parche-*.sh
migrar*.sh